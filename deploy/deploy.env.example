# ----------------------------------------------------------------------------
# ปลายทางของการ deploy — ใช้เฉพาะบนเครื่องเดฟ/เครื่องที่สั่ง deploy
#     cp deploy/deploy.env.example deploy/deploy.env
# ไฟล์ deploy.env ไม่ถูก commit ขึ้น git
# ----------------------------------------------------------------------------

# ต้องเป็นเครื่องที่ ssh เข้าได้ด้วยคีย์ และ user อยู่ในกลุ่ม docker
WEB_SSH=deploy@10.0.0.10
DB_SSH=deploy@10.0.0.20

# โฟลเดอร์ปลายทางบนเครื่อง production
WEB_REMOTE_DIR=/opt/app-docker-example
DB_REMOTE_DIR=/opt/app-docker-example-db

# IP วงภายในของเครื่องฐานข้อมูล (ใช้ตั้งชื่อในใบรับรอง TLS)
DB_INTERNAL_IP=10.0.0.20
