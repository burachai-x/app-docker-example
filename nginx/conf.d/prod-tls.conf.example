# ---------- ตัวอย่างเปิด HTTPS บนเครื่อง web ----------
# วิธีใช้:
#   1) ออกใบรับรองที่เครื่อง web เช่น
#        sudo certbot certonly --standalone -d example.com
#   2) แก้ compose.prod.web.yaml ให้ mount ทั้งใบรับรองและไฟล์นี้:
#        - /etc/letsencrypt:/etc/letsencrypt:ro
#        - ./nginx/conf.d/prod-tls.conf.example:/etc/nginx/conf.d/default.conf:ro
#      แล้วเปิดพอร์ต 443 เพิ่มจาก 80
#   3) docker compose ... up -d nginx

resolver 127.0.0.11 valid=10s ipv6=off;
server_tokens off;

server {
    listen 80;
    server_name example.com;

    # ปล่อยให้ certbot ต่ออายุใบรับรองผ่าน HTTP ได้
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;

    root /usr/share/nginx/html;
    index index.html;

    location / { try_files $uri $uri/ /index.html; }

    location ~ ^/(api|healthz|readyz) {
        set $upstream_app app:3000;
        proxy_pass http://$upstream_app$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
    }
}
