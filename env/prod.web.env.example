# ----------------------------------------------------------------------------
# เครื่อง production ฝั่ง WEB (nginx + app)
# คัดลอกไปเป็น .env ที่ /opt/app-docker-example/.env บนเครื่อง web แล้วแก้ค่า
#     cp env/prod.web.env.example .env && chmod 600 .env
# ไฟล์นี้มีรหัสผ่าน — ห้าม commit ขึ้น git
# ----------------------------------------------------------------------------

# พอร์ตที่เปิดออกสู่ภายนอก
HTTP_PORT=80

# ---- ฐานข้อมูลที่อยู่คนละเครื่อง ----
DB_HOST=10.0.0.20        # IP วงภายในของเครื่องฐานข้อมูล
DB_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME   # ต้องตรงกับ .env ของเครื่องฐานข้อมูล และห้ามมีช่องว่าง

# require = เข้ารหัสแต่ไม่ตรวจใบรับรอง (พอสำหรับ self-signed ในวงภายใน)
# verify-full = ตรวจใบรับรองด้วย ต้องส่ง CA ให้ app ด้วย
DB_SSLMODE=require
DB_POOL_MAX=10

# ให้ app รัน migration ตอนสตาร์ตหรือไม่
# ถ้ามี app หลายตัวก็ปลอดภัย เพราะ migration ใช้ advisory lock กันชนกันอยู่แล้ว
RUN_MIGRATIONS=true
