# ----------------------------------------------------------------------------
# เครื่อง production ฝั่ง DATABASE (postgres + backup)
# คัดลอกไปเป็น .env ที่ /opt/app-docker-example-db/.env บนเครื่องฐานข้อมูล
#     cp env/prod.db.env.example .env && chmod 600 .env
# ----------------------------------------------------------------------------

# IP วงภายในของ "เครื่องนี้" ที่จะให้ postgres ฟัง
# ห้ามใส่ 0.0.0.0 เพราะจะเปิดฐานข้อมูลออกทุกอินเทอร์เฟซรวมถึงขาอินเทอร์เน็ต
DB_BIND_ADDRESS=10.0.0.20
DB_PORT=5432

POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME   # ต้องตรงกับ .env ของเครื่อง web และห้ามมีช่องว่าง

# ปรับตามสเปกเครื่อง (shared_buffers ประมาณ 25% ของ RAM)
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=256MB

# สำรองข้อมูล
BACKUP_INTERVAL_SECONDS=86400   # วันละครั้ง
BACKUP_KEEP_DAYS=7
