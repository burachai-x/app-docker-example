# ----------------------------------------------------------------------------
# เครื่องเดฟ: ไม่จำเป็นต้องใช้ไฟล์นี้ก็ได้ เพราะ compose.dev.yaml มีค่า default ครบแล้ว
# คัดลอกเป็น .env ที่รากโปรเจกต์เฉพาะตอนที่พอร์ตชนกับของเดิมในเครื่อง หรืออยากเปลี่ยนรหัสผ่าน
#     cp env/dev.env.example .env
# ----------------------------------------------------------------------------

# พอร์ตที่เปิดบนเครื่องเดฟ (เปลี่ยนได้ถ้าชนกับโปรเจกต์อื่น)
WEB_PORT=8080          # เข้าเว็บที่ http://localhost:8080
APP_PORT=3000          # ยิง API ตรงโดยไม่ผ่าน nginx
DB_PORT_HOST=5432      # ต่อ DBeaver/psql จากเครื่องตัวเอง

# ฐานข้อมูลของเครื่องเดฟ
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=devpassword
